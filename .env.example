# -------------------------------------------------------
# Environment variables — copy to .env and fill in values
# Never commit .env to version control
# -------------------------------------------------------

# KitchenOwl connection (required)
# Use the nginx frontend container, not the backend directly — the backend
# speaks uwsgi binary protocol, not HTTP. Adjust the hostname to match your
# docker-compose service/container name for the KitchenOwl web container.
KITCHENOWL_API_URL=http://kitchenowl-front:80
KITCHENOWL_API_TOKEN=your-long-lived-token-here

# KitchenOwl household (defaults shown)
KITCHENOWL_HOUSEHOLD_ID=1
KITCHENOWL_DEFAULT_LIST_ID=1

# Server port (default: 8000)
MCP_PORT=8000

# -------------------------------------------------------
# Chat UI (optional, default disabled) — embeds a browser chat backed by
# Anthropic + the KitchenOwl tools, in the same container as the MCP server.
# -------------------------------------------------------
# ENABLE_CHAT_UI=true

# Shared-password login (one of two login methods; required if you want
# password login — either this or the Authentik trio below must be set)
# CHAT_SHARED_PASSWORD=choose-a-strong-shared-password

# Session cookie signing secret — required if ENABLE_CHAT_UI=true
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# CHAT_SESSION_SECRET=

# Public base URL of this deployment, used to build the Authentik redirect_uri
# CHAT_PUBLIC_BASE_URL=https://kitchenowl-mcp.yourdomain.com

# Authentik OIDC login (the other login method; both can be enabled together)
# AUTHENTIK_ISSUER=https://auth.yourdomain.com/application/o/kitchenowl-mcp/
# AUTHENTIK_CLIENT_ID=
# AUTHENTIK_CLIENT_SECRET=

# Anthropic — required if ENABLE_CHAT_UI=true
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# CHAT_MAX_TOKENS=4096
# CHAT_MAX_TOOL_ROUNDS=8

